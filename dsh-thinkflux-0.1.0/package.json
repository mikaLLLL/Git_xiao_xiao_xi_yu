{
  "name": "dsh-thinkflux",
  "version": "0.1.0",
  "description": "Real-time AI-thinking visualization for the DeepSeek Harness Web GUI: reasoning-delta phrases rewrite the light-ring panels as the model thinks, with think chars/s, step/turn, context and tool dispatch in the HUD.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "background",
    "decoration",
    "canvas",
    "visualization",
    "reasoning",
    "thinking"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
